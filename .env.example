# Read-write token from the Vercel Blob store connected to this project.
# Newer private stores may use BLOB_STORE_ID plus OIDC instead of this token.
BLOB_READ_WRITE_TOKEN=

# Must match the Blob store: private (recommended) or public.
BLOB_ACCESS=private

# Long random string. The office PC sends it as Authorization: Bearer <secret>.
INVENTORY_UPDATE_SECRET=
