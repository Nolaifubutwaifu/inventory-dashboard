# Read-write token from the Vercel Blob store connected to this project.
# Newer private stores may use BLOB_STORE_ID plus OIDC instead of this token.
BLOB_READ_WRITE_TOKEN=

# Must match the Blob store: private (recommended) or public.
BLOB_ACCESS=private

# Long random string. The office PC sends it as Authorization: Bearer <secret>.
# Used by /api/inventory/update, /api/sales/update, and /api/history/update.
INVENTORY_UPDATE_SECRET=

# Optional site password. Leave unset to keep the dashboard open.
# Upload routes keep using the bearer token above.
# DASHBOARD_PASSWORD=

# Set to true to show top customer names. Hidden otherwise.
# SHOW_CUSTOMERS=

# Set to 1 to show data/sales.sample.json when Blob has no sales.json.
# Leave unset in production.
# SALES_PREVIEW=

# Set to 1 to show data/history.sample.json when Blob has no history.json.
# Leave unset in production.
# HISTORY_PREVIEW=
